# Standard Git configuration for Godot projects (no Git LFS required)
* text=auto eol=lf
*.bat text eol=crlf

# Ensure 3D models and binary textures are treated as binary
*.png binary
*.jpg binary
*.glb binary
*.fbx binary
*.obj binary

# Ensure Godot text scenes, scripts, and resources preserve proper line endings
*.tres text eol=lf
*.tscn text eol=lf
*.gd text eol=lf
*.godot text eol=lf
